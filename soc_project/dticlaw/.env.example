# DTIClaw Environment Configuration
# Copy ke .env sebelum run

# Gateway
OPENCLAW_GATEWAY_PORT=18889
OPENCLAW_GATEWAY_BIND=loopback
OPENCLAW_GATEWAY_AUTH=none

# Ollama (local only)
OLLAMA_HOST=127.0.0.1:11434

# TurboVec RAG
TURBOVEC_DATA_DIR=~/dticlaw/data/turbovec
TURBOVEC_DIM=768
TURBOVEC_BIT_WIDTH=4

# ChromaDB (fallback)
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001

# Embedding model
DTICLAW_EMBED_MODEL=nomic-embed-text

# Default LLM
DTICLAW_MODEL_CHAT=gemma2:9b
DTICLAW_MODEL_REASONING=llama3.1:8b
DTICLAW_MODEL_VISION=gemma3:1b

# Security
DTICLAW_PERMISSION_GATE=strict
DTICLAW_MAX_TIMEOUT=300
DTICLAW_AUDIT_LOG=~/dticlaw/logs/audit.log

# Disable telemetry
OPENCLAW_TELEMETRY=off

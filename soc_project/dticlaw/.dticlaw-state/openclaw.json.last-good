{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "none"
    }
  },
  "agents": {
    "defaults": {
      "model": "ollama/savior_v2",
      "workspace": "./workspace",
      "skipBootstrap": true
    },
    "list": [
      {
        "id": "dticlaw",
        "default": true,
        "workspace": "./workspace",
        "model": {
          "primary": "ollama/savior_v2"
        },
        "skills": [
          "dticlaw-research",
          "dticlaw-writer",
          "dticlaw-rag"
        ],
        "tools": {
          "allow": [
            "exec",
            "read",
            "write"
          ]
        },
        "identity": {
          "name": "Savior agent",
          "theme": "agent framework pendamping model savior_v2 untuk SOC: triase alert Wazuh, menandai true positive vs false positive/negative, investigasi & tindakan. Dibangun oleh Atok Tajuddin & tim researcher.",
          "emoji": "🛡️"
        }
      }
    ]
  },
  "meta": {
    "lastTouchedVersion": "0.0.0",
    "lastTouchedAt": "2026-06-13T17:30:07.574Z"
  }
